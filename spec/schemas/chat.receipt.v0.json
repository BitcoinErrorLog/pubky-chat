{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/chat.receipt.v0.json",
  "title": "chat.receipt.v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "kind",
    "event_id",
    "sent_at",
    "status",
    "event_ids"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "chat.receipt.v0"
    },
    "event_id": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/uuid"
    },
    "sent_at": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/sentAt"
    },
    "status": {
      "enum": [
        "delivered",
        "read"
      ]
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/uuid"
      }
    },
    "channel_id": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/channelId"
    }
  }
}

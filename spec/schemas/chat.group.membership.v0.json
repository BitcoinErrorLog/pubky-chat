{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/chat.group.membership.v0.json",
  "title": "chat.group.membership.v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "kind",
    "event_id",
    "sent_at",
    "channel_id",
    "op"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "chat.group.membership.v0"
    },
    "event_id": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/uuid"
    },
    "sent_at": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/sentAt"
    },
    "channel_id": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/channelId"
    },
    "op": {
      "enum": [
        "create",
        "add",
        "remove",
        "leave"
      ]
    },
    "subject_pubky": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/pubky"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/pubky"
      }
    }
  }
}

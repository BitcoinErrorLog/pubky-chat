{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/marketplace.chat_message.v0.json",
  "title": "marketplace.chat_message.v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "kind",
    "event_id",
    "conversation_id",
    "listing_ref",
    "sent_at",
    "body"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "marketplace.chat_message.v0"
    },
    "event_id": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/uuid"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "listing_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sent_at": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/sentAtInbound"
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  }
}

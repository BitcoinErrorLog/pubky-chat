{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/chat.context.v0.json",
  "title": "chat.context.v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "kind",
    "event_id",
    "sent_at",
    "subject"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "chat.context.v0"
    },
    "event_id": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/uuid"
    },
    "sent_at": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/sentAt"
    },
    "subject": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/subject"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "not": {
    "required": [
      "channel_id"
    ]
  }
}

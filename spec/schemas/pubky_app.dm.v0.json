{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/pubky_app.dm.v0.json",
  "title": "pubky_app.dm.v0",
  "type": "object",

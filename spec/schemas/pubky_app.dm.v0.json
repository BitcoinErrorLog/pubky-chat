    },
    "kind": {
      "const": "pubky_app.dm.v0"
    },
    "event_id": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/uuid"
    },
    "sent_at": {
      "$ref": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/_defs.json#/definitions/sentAtInbound"
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BitcoinErrorLog/pubky-chat/spec/schemas/chat.group.invite.v0.json",
  "title": "chat.group.invite.v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
